# Copy this to `.env` (git-ignored) in the same directory as docker-compose.yml
# and fill in real values. docker-compose reads .env automatically for the
# ${VAR} substitutions in docker-compose.yml.

# ── 資料庫 ─────────────────────────────────────────────────────────────────
# 指向既有的 Azure PostgreSQL（外部代管，不是這個 repo 的 docker-compose 管理的
# container，遷移到自架 Docker 後這個連線維持不變）。
DATABASE_URL=postgresql://user:password@toufen.postgres.database.azure.com:5432/postgres?sslmode=require

# 預設操作資料表（可選，預設 public.n_kc_ctl）
DEFAULT_TABLE=public.n_kc_ctl

# ── 其他 ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
